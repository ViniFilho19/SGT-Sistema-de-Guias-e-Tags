# Copie para .env e ajuste. Gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# DATABASE_URL vazio = SQLite em data/etiquetas.db (padrão)
# DATABASE_URL=sqlite:///./data/etiquetas.db
# PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/etiquetas
ACCESS_TOKEN_MINUTES=480
# Coloque true quando publicar com HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SEGURO=false
